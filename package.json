{
  "name": "npm-downloads-corrected",
  "version": "1.6.2",
  "private": true,
  "type": "module",
  "description": "Chrome extension that corrects outage dips in npmjs.com download stats by comparing against huge reference packages.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "zip": "npm run build && node scripts/build.ts --zip"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "11.0.1"
  }
}
